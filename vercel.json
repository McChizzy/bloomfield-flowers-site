{
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "crons": [
    {
      "path": "/api/keep-alive",
      "schedule": "0 9 * * *"
    }
  ],
  "rewrites": [
    { "source": "/birthday-flowers-lagos", "destination": "/birthday-flowers-lagos.html" },
    { "source": "/birthday-flowers-abuja", "destination": "/birthday-flowers-abuja.html" },
    { "source": "/birthday-flowers-port-harcourt", "destination": "/birthday-flowers-port-harcourt.html" },
    { "source": "/anniversary-flowers-lagos", "destination": "/anniversary-flowers-lagos.html" },
    { "source": "/anniversary-flowers-abuja", "destination": "/anniversary-flowers-abuja.html" },
    { "source": "/anniversary-flowers-port-harcourt", "destination": "/anniversary-flowers-port-harcourt.html" },
    { "source": "/graduation-flowers-lagos", "destination": "/graduation-flowers-lagos.html" },
    { "source": "/graduation-flowers-abuja", "destination": "/graduation-flowers-abuja.html" },
    { "source": "/graduation-flowers-port-harcourt", "destination": "/graduation-flowers-port-harcourt.html" },
    { "source": "/flower-delivery-lagos", "destination": "/flower-delivery-lagos.html" },
    { "source": "/flower-delivery-abuja", "destination": "/flower-delivery-abuja.html" },
    { "source": "/flower-delivery-port-harcourt", "destination": "/flower-delivery-port-harcourt.html" },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://connect.facebook.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: https: https://*.cdninstagram.com https://*.fbcdn.net; connect-src 'self' https://api-d.squadco.com https://sandbox-api-d.squadco.com https://bloomfieldflowers.ng https://www.facebook.com" }
      ]
    }
  ]
}
